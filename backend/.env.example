# Django
DJANGO_SETTINGS_MODULE=config.settings.development
# Debe tener al menos 32 bytes aleatorios. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local
# Cambiar usuario, contraseña y puerto según la instalación local.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/situr_smart

# Clientes autorizados durante el desarrollo y produccion
CORS_ALLOWED_ORIGINS=https://situr-smart-web.vercel.app,http://localhost:4200,http://localhost:8080

# Tokens
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Brevo (Sendinblue) Email & OTP Recovery
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=jcvillarroeld126@ficct.uagrm.edu.bo
BREVO_SENDER_NAME=SITUR-SMART
PASSWORD_RESET_OTP_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_SECONDS=60

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# openrouteservice / HeiGIT - geocodificacion de direcciones
# Solo la lee el backend. Sin clave, la busqueda de direcciones responde 503 y
# el mapa sigue funcionando con el pin manual.
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key
OPENROUTESERVICE_TIMEOUT_SECONDS=6
GEOCODING_COUNTRY=BOL
GEOCODING_THROTTLE_RATE=30/min


# Asistente virtual IA (CU36) - cualquier proveedor compatible con OpenAI.
# Groq (gratis): https://console.groq.com -> API Keys. Para cambiar a Gemini o
# Grok basta con cambiar IA_BASE_URL, IA_API_KEY e IA_MODEL.
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Grok:   https://api.x.ai/v1
# Sin IA_API_KEY el chat se oculta y el resto de la plataforma sigue igual.
IA_BASE_URL=https://api.groq.com/openai/v1
IA_API_KEY=
IA_MODEL=openai/gpt-oss-120b
IA_STT_MODEL=whisper-large-v3-turbo
IA_TIMEOUT_SECONDS=30
IA_MAX_TOKENS=1024
IA_THROTTLE_RATE=10/min
IA_VOICE_THROTTLE_RATE=6/min

# Notificaciones push (Firebase Cloud Messaging)
# Firebase > Configuracion del proyecto > Cuentas de servicio > Generar nueva
# clave privada. El JSON descargado va en base64, en una sola linea:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("clave.json"))
# Es secreta: nunca al repo. Sin ella los avisos quedan solo en la bandeja.
FIREBASE_CREDENTIALS_BASE64=
