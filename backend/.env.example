# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local
# Cambiar usuario, contraseña y puerto según la instalación local.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/situr_smart

# Clientes autorizados durante el desarrollo y produccion
CORS_ALLOWED_ORIGINS=https://situr-smart-web.vercel.app,http://localhost:4200,http://localhost:8080

# Tokens
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Brevo (Sendinblue) Email & OTP Recovery
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=jcvillarroeld126@ficct.uagrm.edu.bo
BREVO_SENDER_NAME=SITUR-SMART
PASSWORD_RESET_OTP_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_SECONDS=60

